import com.fasterxml.jackson.annotation.JsonIgnoreProperties;
import com.fasterxml.jackson.annotation.JsonProperty;
import lombok.Data;

@Data
@JsonIgnoreProperties(ignoreUnknown = true)
public class CardTPVResponse {

    @JsonProperty("EIS_RESPONSE")
    private EisResponse eisResponse;

    @JsonProperty("ERROR_CODE")
    private String errorCode;

    @JsonProperty("ERROR_DESCRIPTION")
    private String errorDescription;

    @JsonProperty("RESPONSE_STATUS")
    private String responseStatus;   // "0" = success
}

// ---------- EisResponse.java ----------
@Data
@JsonIgnoreProperties(ignoreUnknown = true)
public class EisResponse {

    @JsonProperty("ChannelDetails")
    private java.util.List<ChannelDetail> channelDetails;

    @JsonProperty("ResponseCode")
    private String responseCode;     // "00" = success
}

// ---------- ChannelDetail.java ----------
@Data
@JsonIgnoreProperties(ignoreUnknown = true)
public class ChannelDetail {

    @JsonProperty("Flag")
    private String flag;             // Y / N / blank

    @JsonProperty("mLimit")
    private String mLimit;

    @JsonProperty("cId")             // DOM, INT, ATM, POS, ECOM, NFC, QAF, OZF
    private String cId;

    @JsonProperty("eLimit")
    private String eLimit;

    @JsonProperty("ExpDate")         // only present for some channels (OZF)
    private String expDate;
}

// ---------- EisEncryptedEnvelope.java ----------
// This is what EIS sends BACK (encrypted). Do NOT use CardTPVResponse for it.
// Change the @JsonProperty/@JsonAlias name to match the real field in your raw response.
@Data
@JsonIgnoreProperties(ignoreUnknown = true)
public class EisEncryptedEnvelope {

    @JsonProperty("ENCRYPTED_RESPONSE")
    @com.fasterxml.jackson.annotation.JsonAlias({"encryptedResponse", "EncryptedResponse", "ENC_RESPONSE"})
    private String encryptedResponse;
}


