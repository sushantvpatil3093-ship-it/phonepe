public CardTPVResponse getCardTpvFlag(String aesKey, String accessToken, String eisRequest) {

    URI uri = URI.create(getBaseUrl() + TPV_API_ENDPOINT);
    logger.info("Card TPV uri: {}", uri);

    String eisResponseString = getWebClient().post()
            .uri(uri)
            .header("Content-Type", MediaType.APPLICATION_JSON_VALUE)
            .header("Accept", MediaType.APPLICATION_JSON_VALUE)
            .header("AccessToken", accessToken)          // RSA-encrypted AES key (NOT the file path)
            .bodyValue(eisRequest)
            .retrieve()
            .onStatus(
                status -> status.is4xxClientError() || status.is5xxServerError(),
                resp -> resp.bodyToMono(String.class).flatMap(errBody -> {
                    logger.error("EIS TPV failed. status: {}, body: {}",
                            resp.statusCode().value(), errBody);
                    return Mono.error(new TransactionException(
                            TransactionErrorConstants.EXTERNAL_SERVICE_ERROR_CODE,
                            MessageFormat.format(
                                TransactionErrorConstants.EXTERNAL_SERVICE_ERROR_MESSAGE,
                                "EIS TPV Service")));
                }))
            .bodyToMono(String.class)
            .block();

    logger.info("Card TPV raw response: {}", eisResponseString);
    return getEISEComResponse(aesKey, eisResponseString);
}

private CardTPVResponse getEISEComResponse(String aesKey, String eisResponseString) {
    try {
        // Step 1: read the encrypted wrapper
        EisEncryptedEnvelope envelope =
                objectMapper.readValue(eisResponseString, EisEncryptedEnvelope.class);

        // Step 2: decrypt with the same AES key you used for the request
        String decrypted = DCMSEISEncryptionDecryptionUtil.decrypt(
                envelope.getEncryptedResponse(), aesKey);
        logger.info("Decrypted Card TPV Response: {}", decrypted);

        // Step 3: map to the highlighted structure
        // {"EIS_RESPONSE":{"ChannelDetails":[...],"ResponseCode":"00"},
        //  "ERROR_CODE":"","ERROR_DESCRIPTION":"","RESPONSE_STATUS":"0"}
        return objectMapper.readValue(decrypted, CardTPVResponse.class);

    } catch (JsonProcessingException e) {
        logger.error("Error creating Card TPV Response: {} response: {}",
                e.getMessage(), eisResponseString);
        throw new TransactionException(
                TransactionErrorConstants.JSON_ERROR_CODE,
                MessageFormat.format(TransactionErrorConstants.JSON_ERROR_MESSAGE,
                        eisResponseString));
    }
}


