 * All rights reserved
 *
 * Description: PhonePe V4 Debit SDKless - API 1 Debit, API 2 Webhook, API 3 Status
 * Version:1.0
 */
@Service
@RequiredArgsConstructor
public class PhonePeService {

    private final LoggerUtility logger = LoggerFactoryUtility.getLogger(this.getClass());
    private static final String PAYMENT_SCOPE = "PHONEPE";

    private final PaymentValidator paymentValidator;
    private final PhonePeValidator phonePeValidator;
    private final PhonePeWebClientService phonePeWebClientService;
    private final PhonePeDao phonePeDao;
    private final PhonePeProperties properties;
    private final ObjectMapper objectMapper;

    // ---------------------------------------------------------------
    // API 1: POST /api/v1/phonepe/initiate -> PhonePe POST /v4/debit
    // ---------------------------------------------------------------

    /**
     * @Method-Description: Process PhonePe V4 debit initiation
     * @param: phonePeInitiationRequest
     * @Exception: or @Error :Exception
     */
    @Transactional
    public PaymentResponse<?> initiatePayment(PhonePeInitiationRequest phonePeInitiationRequest) {
        //Validate PhonePe request
        phonePeValidator.validatePhonePeAuthRequest(getPaymentInitiationRequest(phonePeInitiationRequest.getAtrn()));
        logger.info("Payment Initiation Request validated successfully for Atrn :: {} ", phonePeInitiationRequest.getAtrn());

        TransactionDto transactionDto = phonePeDao.getTransactionForInitiation(phonePeInitiationRequest.getAtrn());
        logger.info("Payment Initiation get atrn details transactionDto:: {} ", transactionDto);

        //validate debit amount
        paymentValidator.validateDebitAmount(transactionDto.getDebitAmt());
        //validate currency code (PhonePe supports INR only)
        phonePeValidator.validateCurrencyCode(transactionDto.getCurrencyCode());
        logger.info("Amount validated successfully :: {}", transactionDto.getDebitAmt());

        PhonePeDebitResponse phonePeDebitResponse = processDebitRequest(transactionDto);
        logger.info("PhonePe Debit Response code {} for reference no {} ",
                phonePeDebitResponse.getCode(), transactionDto.getAtrnNum());

        PhonePeResponseDto phonePeResponseDto = PhonePeResponseDto.builder()
                .atrn(transactionDto.getAtrnNum())
                .redirectType(phonePeDebitResponse.getData().getRedirectType())
                .redirectUrl(phonePeDebitResponse.getData().getRedirectURL())
                .build();
        logger.info("PhonePe- phonePeResponseDto: {}", phonePeResponseDto);

        return PaymentResponse.builder()
                .data(List.of(phonePeResponseDto))
                .status(PaymentConstants.API_RESPONSE_STATUS_SUCCESS)
                .build();
    }

    private PhonePeDebitResponse processDebitRequest(TransactionDto transactionDto) {
        PhonePeDebitRequest debitRequest = PhonePeDebitRequest.builder()
                .merchantId(properties.getMerchantId())
                .transactionId(transactionDto.getAtrnNum())
                .amount(PhonePeUtil.rupeesToPaise(transactionDto.getDebitAmt()))
                .paymentScope(PAYMENT_SCOPE)
                .build();

        String base64Payload = PhonePeUtil.toBase64(toJson(debitRequest));
        String requestPayload = toJson(new PhonePeDebitEnvelope(base64Payload));

        Map<String, String> requestHeaders = new HashMap<>();
        requestHeaders.put("X-VERIFY", PhonePeUtil.debitChecksum(
                base64Payload, properties.getDebitChecksumPath(), properties.getSaltKey(), properties.getSaltIndex()));
        requestHeaders.put("X-CALLBACK-URL", properties.getCallbackUrl());

        PhonePeDebitResponse response = phonePeWebClientService.initiatePhonePeWebClient(
                HttpMethod.POST, properties.getBaseUrl() + properties.getDebitPath(),
                requestPayload, PhonePeDebitResponse.class, requestHeaders);

        if (response == null
                || !response.isSuccess()
                || response.getData() == null
                || response.getData().getRedirectURL() == null) {
            logger.error("PhonePe debit failed for atrn {}", transactionDto.getAtrnNum());
            throw new PaymentException(ErrorConstants.EXTERNAL_SERVICE_ERROR_CODE,
                    "PhonePe debit failed: " + (response == null ? "no response" : response.getCode()));
        }
        return response;
    }

    // ---------------------------------------------------------------
    // API 2: PhonePe -> POST /api/v1/phonepe/webhook (server to server)
    // ---------------------------------------------------------------

    /**
     * @Method-Description: Process the server-to-server callback sent by PhonePe when a payment completes.
     * By default only the ATRN is taken from the body and the real result is fetched from the status API.
     * @param: rawBody, xVerify
     * @Exception: or @Error :Exception
     */
    @Transactional
    public void processWebhook(String rawBody, String xVerify) {
        if (properties.isWebhookVerifyEnabled()) {
            String expected = PhonePeUtil.webhookChecksum(rawBody, properties.getSaltKey(), properties.getSaltIndex());
            if (!PhonePeUtil.safeEquals(expected, xVerify)) {
                logger.error("PhonePe webhook rejected: invalid checksum");
                throw new PaymentException(ErrorConstants.INVALID_ERROR_CODE, "Invalid webhook checksum");
            }
        }

        PhonePeTransactionStatusResponse webhookResponse = parseWebhook(rawBody);
        if (webhookResponse.getData() == null || webhookResponse.getData().getTransactionId() == null) {
            logger.error("PhonePe webhook without transaction data, code :: {} ", webhookResponse.getCode());
            return;
        }

        String atrn = webhookResponse.getData().getTransactionId();
        logger.info("PhonePe webhook received for Atrn :: {} code :: {} ", atrn, webhookResponse.getCode());

        if (properties.isWebhookConfirmWithStatus()) {
            // do not trust the webhook body: ask PhonePe (signed with our salt key) for the real result
            processPaymentResult(atrn, fetchStatusFromPhonePe(atrn));
        } else {
            // local testing only
            processPaymentResult(atrn, webhookResponse);
        }
    }

    // ---------------------------------------------------------------
    // API 3: POST /api/v1/phonepe/status -> PhonePe GET /v4/transaction/{merchantId}/{atrn}/status
    // ---------------------------------------------------------------

    /**
     * @Method-Description: Ask PhonePe for the payment status and update DB (call until SUCCESS or FAILED)
     * @param: phonePeStatusRequest
     * @Exception: or @Error :Exception
     */
    @Transactional
    public PaymentResponse<?> getPaymentStatus(PhonePeStatusRequest phonePeStatusRequest) {
        phonePeValidator.validatePhonePeAuthRequest(getPaymentInitiationRequest(phonePeStatusRequest.getAtrn()));
        logger.info("PhonePe status request validated successfully for Atrn :: {} ", phonePeStatusRequest.getAtrn());

        PhonePeTransactionStatusResponse response = fetchStatusFromPhonePe(phonePeStatusRequest.getAtrn());
        PhonePePaymentState state = processPaymentResult(phonePeStatusRequest.getAtrn(), response);

        PhonePeStatusResponseDto phonePeStatusResponseDto = PhonePeStatusResponseDto.builder()
                .atrn(phonePeStatusRequest.getAtrn())
                .paymentStatus(state == null ? "UNKNOWN" : state.name())
                .phonePeCode(response.getCode())
                .providerReferenceId(response.getData() == null ? null : response.getData().getProviderReferenceId())
                .build();
        logger.info("PhonePe- phonePeStatusResponseDto: {}", phonePeStatusResponseDto);

        return PaymentResponse.builder()
                .data(List.of(phonePeStatusResponseDto))
                .status(PaymentConstants.API_RESPONSE_STATUS_SUCCESS)
                .build();
    }

    /** Calls PhonePe V4 status API (used by API 2 Webhook and API 3 Status) */
    private PhonePeTransactionStatusResponse fetchStatusFromPhonePe(String atrn) {
        String path = PhonePeUtil.buildStatusPath(properties.getStatusPath(), properties.getMerchantId(), atrn);

        Map<String, String> requestHeaders = new HashMap<>();
        requestHeaders.put("X-VERIFY",
                PhonePeUtil.statusChecksum(path, properties.getSaltKey(), properties.getSaltIndex()));
        // optional headers from the docs (X-PROVIDER-ID, X-CLIENT-ID, X-CLIENT-VERSION) can be added here

        PhonePeTransactionStatusResponse response = phonePeWebClientService.initiatePhonePeWebClient(
                HttpMethod.GET, properties.getStatusBaseUrl() + path,
                null, PhonePeTransactionStatusResponse.class, requestHeaders);
        if (response == null) {
            throw new PaymentException(ErrorConstants.EXTERNAL_SERVICE_ERROR_CODE, "Empty response from PhonePe");
        }
        return response;
    }

    // ---------------------------------------------------------------
    // Common for webhook and status
    // ---------------------------------------------------------------

    private PhonePePaymentState processPaymentResult(String atrn, PhonePeTransactionStatusResponse response) {
        PhonePePaymentState state = PhonePeUtil.toPaymentState(response.getCode());
        if (state == null || state == PhonePePaymentState.NOT_FOUND) {
            logger.info("PhonePe result not applied for Atrn :: {} code :: {} ", atrn, response.getCode());
            return state;
        }

        if (state == PhonePePaymentState.SUCCESS) {
            PhonePeTransactionStatusData data = response.getData();
            if (data == null || data.getPaidAmount() == null) {
                throw new PaymentException(ErrorConstants.EXTERNAL_SERVICE_ERROR_CODE,
                        "PhonePe success response without paid amount");
            }
            //validate paid amount with the amount saved in DB
            phonePeValidator.validateDebitAmount(phonePeDao.getDebitAmountByAtrn(atrn),
                    PhonePeUtil.paiseToRupees(data.getPaidAmount()).toPlainString());
            logger.info("Paid amount validated successfully for Atrn :: {} ", atrn);
        }

        phonePeDao.updatePaymentResult(atrn, state, response);
        return state;
    }

    private PaymentInitiationRequest getPaymentInitiationRequest(String atrn) {
        // copy the body of your getInitiationPaypalRequest if it sets more fields
        return PaymentInitiationRequest.builder()
                .atrn(atrn)
                .build();
    }

    private PhonePeTransactionStatusResponse parseWebhook(String rawBody) {
        try {
            return objectMapper.readValue(rawBody, PhonePeTransactionStatusResponse.class);
        } catch (JsonProcessingException e) {
            logger.error("PhonePe webhook body could not be read");
            throw new PaymentException(ErrorConstants.INVALID_ERROR_CODE, "Invalid webhook body");
        }
    }

    private String toJson(Object value) {
        try {
            return objectMapper.writeValueAsString(value);
        } catch (JsonProcessingException e) {
            throw new PaymentException(ErrorConstants.EXTERNAL_SERVICE_ERROR_CODE,
                    "Could not build PhonePe request");
        }
    }
}







