package com.epay.payment.service;

import io.netty.handler.ssl.SslContext;
import io.netty.handler.ssl.SslContextBuilder;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.http.HttpMethod;
import org.springframework.http.MediaType;
import org.springframework.http.client.reactive.ReactorClientHttpConnector;
import org.springframework.stereotype.Service;
import org.springframework.web.reactive.function.client.ClientResponse;
import org.springframework.web.reactive.function.client.WebClient;
import reactor.core.publisher.Mono;
import reactor.netty.http.client.HttpClient;
import reactor.netty.transport.ProxyProvider;

import javax.net.ssl.SSLException;
import java.time.Duration;
import java.util.Map;

/**
 * Single web client for every PhonePe call (API 1 Debit = POST, API 3 Status = GET)
 */
@Service
public class PhonePeWebClientService {

    private final LoggerUtility logger = LoggerFactoryUtility.getLogger(this.getClass());

    @Value("${https.proxyHost:}")
    private String proxyHost;

    @Value("${https.proxyPort:0}")
    private int proxyPort;

    /**
     * @Method-Description: Call a PhonePe API (POST when requestPayload is given, GET when it is null)
     * @param: httpMethod, url, requestPayload, responseDto, requestHeaders
     * @Exception: or @Error :PaymentException
     */
    public <T> T initiatePhonePeWebClient(HttpMethod httpMethod, String url, String requestPayload,
                                          Class<T> responseDto, Map<String, String> requestHeaders) {
        logger.info("PhonePe call started, method :: {} ", httpMethod);
        WebClient.RequestBodySpec requestSpec = buildWebClient()
                .method(httpMethod)
                .uri(url)
                .headers(httpHeaders -> {
                    if (requestHeaders != null) {
                        requestHeaders.forEach(httpHeaders::set);
                    }
                });

        WebClient.ResponseSpec responseSpec = (requestPayload == null
                ? requestSpec.retrieve()
                : requestSpec.bodyValue(requestPayload).retrieve())
                .onStatus(status -> status.isError(), this::handleError);

        T response = responseSpec.bodyToMono(responseDto).block();
        logger.info("PhonePe call completed, method :: {} ", httpMethod);
        return response;
    }

    private WebClient buildWebClient() {
        SslContext sslContext;
        try {
            sslContext = SslContextBuilder.forClient().protocols("TLSv1.2").build();
        } catch (SSLException e) {
            throw new PaymentException(ErrorConstants.EXTERNAL_SERVICE_ERROR_CODE, "Could not create TLS context");
        }
        HttpClient httpClient = HttpClient.create()
                .secure(spec -> spec.sslContext(sslContext))
                .responseTimeout(Duration.ofSeconds(30));
        if (proxyHost != null && !proxyHost.isBlank() && proxyPort > 0) {
            httpClient = httpClient.proxy(proxy -> proxy.type(ProxyProvider.Proxy.HTTP)
                    .host(proxyHost).port(proxyPort));
        }
        return WebClient.builder()
                .clientConnector(new ReactorClientHttpConnector(httpClient))
                .defaultHeader("Content-Type", MediaType.APPLICATION_JSON_VALUE)
                .build();
    }

    private Mono<? extends Throwable> handleError(ClientResponse response) {
        int status = response.statusCode().value();
        logger.error("PhonePe returned HTTP status :: {} ", status);
        return response.releaseBody().then(Mono.error(new PaymentException(
                ErrorConstants.EXTERNAL_SERVICE_ERROR_CODE, "PhonePe returned HTTP " + status)));
    }
}






package com.epay.payment.controller;

import jakarta.validation.Valid;
import lombok.RequiredArgsConstructor;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

/**
 * PhonePe endpoints: 1 initiate, 2 webhook (called by PhonePe), 3 status
 */
@RestController
@RequestMapping("/api/v1/phonepe")
@RequiredArgsConstructor
public class PhonePeController {

    private final PhonePeService phonePeService;

    /** API 1: start payment, returns the ppe:// link */
    @PostMapping("/initiate")
    public ResponseEntity<PaymentResponse<?>> initiate(@Valid @RequestBody PhonePeInitiationRequest request) {
        return ResponseEntity.ok(phonePeService.initiatePayment(request));
    }

    /** API 2: PhonePe calls this when the payment completes. Must be public (no login). */
    @PostMapping("/webhook")
    public ResponseEntity<String> webhook(@RequestBody String rawBody,
                                          @RequestHeader(value = "X-VERIFY", required = false) String xVerify) {
        phonePeService.processWebhook(rawBody, xVerify);
        return ResponseEntity.ok("OK");
    }

    /** API 3: ask PhonePe for the status (call until SUCCESS or FAILED) */
    @PostMapping("/status")
    public ResponseEntity<PaymentResponse<?>> status(@Valid @RequestBody PhonePeStatusRequest request) {
        return ResponseEntity.ok(phonePeService.getPaymentStatus(request));
    }
}






