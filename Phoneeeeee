package com.epay.payment.dao;

import com.epay.payment.model.phonepe.PhonePePaymentState;
import com.epay.payment.model.phonepe.response.PhonePePaymentMode;
import com.epay.payment.model.phonepe.response.PhonePeTransactionStatusResponse;
import com.epay.payment.util.PhonePeUtil;
import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Repository;

import java.math.BigDecimal;
import java.time.Instant;
import java.time.LocalDateTime;
import java.time.ZoneId;
import java.util.ArrayList;
import java.util.List;

/**
 * DAO for PhonePe: API 1 reads the amount, API 2 (Webhook) and API 3 (Status) save the result
 */
@Repository
@RequiredArgsConstructor
public class PhonePeDao {

    private final LoggerUtility logger = LoggerFactoryUtility.getLogger(this.getClass());

    private final TransactionDao transactionDao;
    private final MerchantOrderPaymentsRepository merchantOrderPaymentsRepository;
    private final PaymentModeRepository paymentModeRepository;      // CHANGE: your pay mode repository

    /** API 1: same lookup as PayPal, returns amount and currency from the DB */
    public TransactionDto getTransactionForInitiation(String atrn) {
        // CHANGE: second argument = the same status value your PayPal service passes here
        return transactionDao.getValidPaymentAckReq(atrn, PaymentStatus.REPLACE_WITH_PAYPAL_VALUE);
    }

    /** API 2 and 3: amount saved in the DB (rupees) to compare with the paid amount */
    public BigDecimal getDebitAmountByAtrn(String atrn) {
        return merchantOrderPaymentsRepository.findById(atrn)
                .orElseThrow(() -> new PaymentException(ErrorConstants.INVALID_ERROR_CODE, "ATRN not found"))
                .getDebitAmt();                                      // CHANGE: your amount getter
    }

    /**
     * API 2 and 3: save the result. Returns false when nothing was changed
     * (pending, not found, or already final from an earlier webhook/status call).
     */
    public boolean updatePaymentResult(String atrn, PhonePePaymentState state,
                                       PhonePeTransactionStatusResponse response) {
        if (state != PhonePePaymentState.SUCCESS && state != PhonePePaymentState.FAILED) {
            return false;
        }
        // row lock: webhook and status call cannot save at the same time
        MerchantOrderPayments payment = merchantOrderPaymentsRepository.findWithLockByAtrnNum(atrn)
                .orElseThrow(() -> new PaymentException(ErrorConstants.INVALID_ERROR_CODE, "ATRN not found"));

        if (isFinal(payment.getStatus())) {                          // CHANGE: your status getter
            logger.info("PhonePe result ignored, payment already final for Atrn :: {} ", atrn);
            return false;
        }

        payment.setStatus(state == PhonePePaymentState.SUCCESS
                ? PaymentStatus.SUCCESS : PaymentStatus.FAILED);     // CHANGE: your status setter
        // CHANGE: if your table has a response code / payment date column, set it here
        // payment.setResponseCode(response.getCode());
        // payment.setPaymentDate(toDateTime(response.getData().getPaymentTimestamp()));

        if (response.getData() != null) {
            payment.setBankReferenceNumber(response.getData().getProviderReferenceId());
        }
        if (state == PhonePePaymentState.SUCCESS && response.getData() != null
                && response.getData().getPaymentModes() != null
                && !response.getData().getPaymentModes().isEmpty()) {
            payment.setPayMode(response.getData().getPaymentModes().get(0).getMode());
        }
        // webhook has no logged-in user: set the audit field here if AuditEntity requires it
        // payment.setUpdatedBy("PHONEPE");

        merchantOrderPaymentsRepository.save(payment);

        if (state == PhonePePaymentState.SUCCESS) {
            savePaymentModes(atrn, response);
        }
        logger.info("PhonePe result saved for Atrn :: {} state :: {} ", atrn, state);
        return true;
    }

    /** One row per PhonePe payment mode in the pay mode table */
    private void savePaymentModes(String atrn, PhonePeTransactionStatusResponse response) {
        if (response.getData() == null || response.getData().getPaymentModes() == null) {
            return;
        }
        List<PaymentMode> rows = new ArrayList<>();                  // CHANGE: your pay mode entity
        for (PhonePePaymentMode mode : response.getData().getPaymentModes()) {
            PaymentMode row = new PaymentMode();
            row.setAtrnNum(atrn);
            row.setPayMode(mode.getMode());
            row.setAmount(PhonePeUtil.paiseToRupees(mode.getAmount()));
            row.setProcessingRail(mode.getProcessingRail());
            row.setReferenceNo(firstNonBlank(mode.getUtr(), mode.getUpiTransactionId(),
                    mode.getPgTransactionId(), mode.getReferenceId()));
            row.setMaskedNumber(firstNonBlank(mode.getMaskedCardNumber(), mode.getMaskedAccountNumber()));
            rows.add(row);
        }
        paymentModeRepository.saveAll(rows);
    }

    private boolean isFinal(String status) {
        return PaymentStatus.SUCCESS.equals(status) || PaymentStatus.FAILED.equals(status);
    }

    private LocalDateTime toDateTime(Long epochMillis) {
        return epochMillis == null ? LocalDateTime.now()
                : LocalDateTime.ofInstant(Instant.ofEpochMilli(epochMillis), ZoneId.of("Asia/Kolkata"));
    }

    private String firstNonBlank(String... values) {
        for (String value : values) {
            if (value != null && !value.isBlank()) {
                return value;
            }
        }
        return null;
    }
}










