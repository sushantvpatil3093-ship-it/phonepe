@Service
@RequiredArgsConstructor
public class CardTpvService {

    private static final LoggerUtility logger =
            LoggerFactoryUtility.getLogger(CardTpvService.class);

    private final SbiEisDao sbiEisDao;
    private final CardTpvUtils cardTpvUtils;

    @Value("${card.tpv.dummy.enabled:false}")
    private boolean dummyEnabled;

    public TransactionResponse<EncryptedResponse> verifyCardTPV(EncryptedRequest request) {

        // Step 1: UI AES key (never log it)
        String aesKeyTxn = sbiEisDao.getEncryptedAESKey();

        // Step 2: decrypt the UI request
        CardVerificationRequest cardReq = TransactionUtil.buildRequestByEncryptRequest(
                request.getEncryptedRequest(), aesKeyTxn, CardVerificationRequest.class);

        // Step 3: validate
        validateRequest(cardReq);
        logger.info("Card TPV started for card {}",
                CardTpvUtils.maskAccountNumber(cardReq.getCardNumber()));

        // Step 4: dummy or real SBI call, with history saved either way
        String status = "FAILED";
        String errorCode = null;
        EisTpvFinalResponse finalResp;
        try {
            if (dummyEnabled) {
                finalResp = buildDummyResponse();
            } else {
                CardTPVResponse sbiResp =
                        cardTpvUtils.getTpvRequestData(cardReq.getCardNumber());
                validateSbiResponse(sbiResp);
                finalResp = buildFinalResponse(sbiResp);
            }
            status = "SUCCESS";
        } catch (TransactionException e) {
            errorCode = e.getErrorCode();
            throw e;
        } finally {
            saveHistory(cardReq, status, errorCode);
        }

        // Step 5: encrypt with the UI key and return
        EncryptedResponse response = EncryptedResponse.builder()
                .encryptedResponse(EncryptionDecryptionUtil.encryptValue(
                        aesKeyTxn, TransactionUtil.toJson(finalResp)))
                .build();

        logger.info("Card TPV completed");
        return TransactionResponse.<EncryptedResponse>builder()
                .data(Collections.singletonList(response))
                .status(TransactionConstant.RESPONSE_SUCCESS)
                .build();
    }

    // ---------- validation ----------

    private void validateRequest(CardVerificationRequest req) {
        if (req == null || req.getCardNumber() == null || req.getCardNumber().isBlank()) {
            throw new TransactionException(
                    TransactionErrorConstants.INVALID_REQUEST_CODE, "Card number is required");
        }
    }

    private void validateSbiResponse(CardTPVResponse r) {
        boolean bad = r == null
                || !"0".equals(r.getResponseStatus())
                || (r.getErrorCode() != null && !r.getErrorCode().isBlank())
                || r.getEisResponse() == null
                || !"00".equals(r.getEisResponse().getResponseCode())
                || r.getEisResponse().getChannelDetails() == null
                || r.getEisResponse().getChannelDetails().isEmpty();
        if (bad) {
            logger.error("SBI TPV failed, code {}", r == null ? "NO_RESPONSE" : r.getErrorCode());
            throw new TransactionException(
                    TransactionErrorConstants.EXTERNAL_SERVICE_ERROR_CODE,
                    "Card verification failed. Please try again.");
        }
    }

    // ---------- response building ----------

    private EisTpvFinalResponse buildFinalResponse(CardTPVResponse r) {
        Map<String, String> flags = new HashMap<>();
        for (CardChannelDetails c : r.getEisResponse().getChannelDetails()) {
            if (c.getCId() != null) {
                flags.put(c.getCId().trim().toUpperCase(), cleanFlag(c.getFlag()));
            }
        }
        return EisTpvFinalResponse.builder()
                .domFlag(flags.get("DOM"))
                .intFlag(flags.get("INT"))
                .posFlag(flags.get("POS"))
                .atmFlag(flags.get("ATM"))
                .nfcFlag(flags.get("NFC"))
                .ecomFlag(flags.get("ECOM"))
                .build();
    }

    // Blank flag (like the QAF row) means "unknown", not "N"
    private String cleanFlag(String f) {
        return (f == null || f.isBlank()) ? null : f.trim().toUpperCase();
    }

    private EisTpvFinalResponse buildDummyResponse() {
        return EisTpvFinalResponse.builder()
                .domFlag("Y").intFlag("N").posFlag("Y")
                .atmFlag("Y").nfcFlag("N").ecomFlag("Y")
                .build();
    }

    // ---------- history ----------

    private void saveHistory(CardVerificationRequest req, String status, String errorCode) {
        try {
            EisApiHistoryDto dto = new EisApiHistoryDto();
            // Match these setter names to your DTO
            dto.setApiName("CARD_TPV");
            dto.setRequest(CardTpvUtils.maskAccountNumber(req.getCardNumber()));
            dto.setResponse(status + (errorCode == null ? "" : ":" + errorCode));
            dto.setCreatedDate(LocalDateTime.now());
            sbiEisDao.saveEisHistory(dto);
        } catch (Exception e) {
            // History failure must never break the card check
            logger.error("Could not save TPV history", e);
        }
    }
}
