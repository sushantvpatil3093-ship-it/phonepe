public TransactionResponse<CardTPVResponse> getDCMSEISTpvInfo(String aesKey, String eisEncryptionKey, String eisTpvRequest) {
    CardTPVResponse eisResponse = tpvServicesClient.getCardTpvFlag(aesKey, eisEncryptionKey, eisTpvRequest);
    logger.info("EISTpvResponse code: {}", eisResponse.getErrorCode());   // don't log the full response

    if (StringUtils.isEmpty(eisResponse.getErrorCode())) {
        return TransactionResponse.<CardTPVResponse>builder()
                .data(List.of(eisResponse))
                .status(TransactionConstant.RESPONSE_SUCCESS)
                /* same extra builder fields as your ecom return, if any */
                .build();
    }
    throw new TransactionException(eisResponse.getErrorCode(), eisResponse.getErrorDescription());
}


