package com.epay.payment.util;

import com.epay.payment.model.phonepe.PhonePePaymentState;

import java.math.BigDecimal;
import java.math.RoundingMode;
import java.nio.charset.StandardCharsets;
import java.security.MessageDigest;
import java.security.NoSuchAlgorithmException;
import java.util.Base64;
import java.util.HexFormat;

public final class PhonePeUtil {

    private static final String SEPARATOR = "###";
    private static final BigDecimal HUNDRED = BigDecimal.valueOf(100);

    private PhonePeUtil() {
    }

    // debit: JSON -> base64
    public static String toBase64(String value) {
        return Base64.getEncoder().encodeToString(value.getBytes(StandardCharsets.UTF_8));
    }

    // debit X-VERIFY: SHA256(base64Payload + path + saltKey) + "###" + saltIndex
    public static String debitChecksum(String base64Payload, String path, String saltKey, String saltIndex) {
        return sha256Hex(base64Payload + path + saltKey) + SEPARATOR + saltIndex;
    }

    // status X-VERIFY: SHA256(path + saltKey) + "###" + saltIndex
    public static String statusChecksum(String path, String saltKey, String saltIndex) {
        return sha256Hex(path + saltKey) + SEPARATOR + saltIndex;
    }

    // webhook X-VERIFY: SHA256(rawBody + saltKey) + "###" + saltIndex (confirm with PhonePe)
    public static String webhookChecksum(String rawBody, String saltKey, String saltIndex) {
        return sha256Hex(rawBody + saltKey) + SEPARATOR + saltIndex;
    }

    // constant-time compare
    public static boolean safeEquals(String expected, String actual) {
        if (expected == null || actual == null) {
            return false;
        }
        return MessageDigest.isEqual(
                expected.getBytes(StandardCharsets.UTF_8),
                actual.getBytes(StandardCharsets.UTF_8));
    }

    // rupees (DB) -> paise (PhonePe)
    public static long rupeesToPaise(BigDecimal rupees) {
        if (rupees == null || rupees.signum() <= 0) {
            throw new IllegalArgumentException("Amount must be greater than zero");
        }
        return rupees.multiply(HUNDRED).setScale(0, RoundingMode.UNNECESSARY).longValueExact();
    }

    // paise (PhonePe) -> rupees (DB)
    public static BigDecimal paiseToRupees(long paise) {
        return BigDecimal.valueOf(paise).divide(HUNDRED, 2, RoundingMode.UNNECESSARY);
    }

    // status path from template /v4/transaction/%s/%s/status
    public static String buildStatusPath(String template, String merchantId, String transactionId) {
        return String.format(template, merchantId, transactionId);
    }

    // PhonePe code -> our state (null for BAD_REQUEST, AUTHORIZATION_FAILED, etc.)
    public static PhonePePaymentState toPaymentState(String code) {
        if (code == null) {
            return null;
        }
        return switch (code) {
            case "PAYMENT_SUCCESS" -> PhonePePaymentState.SUCCESS;
            case "PAYMENT_PENDING" -> PhonePePaymentState.PENDING;
            case "PAYMENT_ERROR", "PAYMENT_DECLINED" -> PhonePePaymentState.FAILED;
            case "TRANSACTION_NOT_FOUND" -> PhonePePaymentState.NOT_FOUND;
            default -> null;
        };
    }

    private static String sha256Hex(String input) {
        try {
            MessageDigest digest = MessageDigest.getInstance("SHA-256");
            return HexFormat.of().formatHex(digest.digest(input.getBytes(StandardCharsets.UTF_8)));
        } catch (NoSuchAlgorithmException e) {
            throw new IllegalStateException("SHA-256 not available", e);
        }
    }
}

