        package com.epay.payment.controller;

import com.epay.payment.model.phonepe.request.PhonePeInitiationRequest;
import com.epay.payment.model.phonepe.request.PhonePeStatusRequest;
import com.epay.payment.service.PhonePeService;
import jakarta.validation.Valid;
import lombok.RequiredArgsConstructor;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestHeader;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

@RestController
@RequestMapping("/api/v1/phonepe")
@RequiredArgsConstructor
public class PhonePeController {

    private final PhonePeService phonePeService;

    // runs 1st: the user taps Pay
    @PostMapping("/initiate")
    public ResponseEntity<PaymentResponse<?>> initiate(
            @Valid @RequestBody PhonePeInitiationRequest phonePeInitiationRequest) {
        return ResponseEntity.ok(phonePeService.initiatePayment(phonePeInitiationRequest));
    }

    // runs automatically: PhonePe calls it after the user pays
    @PostMapping("/webhook")
    public ResponseEntity<Void> webhook(@RequestBody String rawBody,
                                        @RequestHeader(value = "X-VERIFY", required = false) String xVerify) {
        phonePeService.processWebhook(rawBody, xVerify);
        return ResponseEntity.ok().build();
    }

    // runs only when the webhook is late or the result is PENDING
    @PostMapping("/status")
    public ResponseEntity<PaymentResponse<?>> status(
            @Valid @RequestBody PhonePeStatusRequest phonePeStatusRequest) {
        return ResponseEntity.ok(phonePeService.getPaymentStatus(phonePeStatusRequest));
    }
}

                                  
