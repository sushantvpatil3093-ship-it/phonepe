                                  package com.epay.payment.validator;

import org.springframework.stereotype.Component;

import java.math.BigDecimal;
import java.text.MessageFormat;

import static com.epay.payment.util.PaymentConstants.ATRN_LENGTH;

@Component
public class PhonePeValidator extends BaseValidator {

    private final LoggerUtility logger = LoggerFactoryUtility.getLogger(this.getClass());

    public void validatePhonePeAuthRequest(PaymentInitiationRequest paymentInitiationRequest) {
        errorDtoList.clear();
        checkForLeadingTrailingAndSingleSpace(paymentInitiationRequest.getAtrn(), PaymentConstants.ATRN_CONST);
        validateFieldLength(paymentInitiationRequest.getAtrn(), ATRN_LENGTH, PaymentConstants.ATRN_CONST);
        validateFieldWithRegex(paymentInitiationRequest.getAtrn(), PaymentConstants.ATRN_ARRN_REGEX_DIGIT,
                PaymentConstants.ATRN_CONST, PaymentConstants.INVALID_ATRN_CONST);
    }

    public void validateDebitAmount(BigDecimal debitAmt, String value) {
        errorDtoList.clear();
        BigDecimal paidAmount = toBigDecimal(value);
        if (debitAmt == null || paidAmount == null || debitAmt.compareTo(paidAmount) != 0) {
            addError(ErrorConstants.INVALID_ERROR_CODE, MessageFormat.format(ErrorConstants.INVALID_ERROR_MESSAGE,
                    PaymentConstants.DEBIT_AMOUNT_CONST, PaymentConstants.DEBIT_AMOUNT_MISMATCH_CONST));
        }
    }

    public void validateCurrencyCode(String currencyCode) {
        errorDtoList.clear();
        boolean inr = PaymentConstants.INR_CURRENCY.equalsIgnoreCase(currencyCode);
        if (!inr) {
            addError(ErrorConstants.INVALID_ERROR_CODE, MessageFormat.format(ErrorConstants.INVALID_ERROR_MESSAGE,
                    PaymentConstants.CURRENCY_CONST, PaymentConstants.INR_CURRENCY));
        }
    }

    private BigDecimal toBigDecimal(String value) {
        try {
            return value == null ? null : new BigDecimal(value.trim());
        } catch (NumberFormatException e) {
            logger.info("Invalid amount value received :: {} ", value);
            return null;
        }
    }
}



                                  
