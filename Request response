import org.springframework.http.client.reactive.ReactorClientHttpConnector;
import org.springframework.stereotype.Service;
import org.springframework.web.reactive.function.client.ClientResponse;
import org.springframework.web.reactive.function.client.WebClient;
import reactor.core.publisher.Mono;
import reactor.netty.http.client.HttpClient;
import reactor.netty.transport.ProxyProvider;

import javax.net.ssl.SSLException;
import java.util.Map;

/**
 * Copyright (c) 2026 [State Bank of India]
 * All rights reserved
 *
 * Version:1.0
 */
@Service
public class PhonePeWebClientService {

    LoggerUtility logger = LoggerFactoryUtility.getLogger(this.getClass());

    // copy these two fields exactly as declared in PayPalWebClientService
    @Value("${https.proxyHost}")
    private String https_proxyHost;

    @Value("${https.proxyPort}")
    private String https_proxyPort;

    /**
     * @Method-Description: Single generic PhonePe call, used for V4 debit (POST) and V4 status (GET)
     * @param: httpMethod POST or GET
     * @param: url full URL
     * @param: requestPayload JSON body, null for GET
     * @param: responseDto class to read the response into
     * @param: requestHeaders X-VERIFY, X-CALLBACK-URL, etc. (a Content-Type here replaces the JSON default)
     * @return T
     * @Exception: PaymentException
     */
    public <T> T initiatePhonePeWebClient(HttpMethod httpMethod, String url, String requestPayload,
                                          Class<T> responseDto, Map<String, String> requestHeaders) {
        logger.info("PhonePe {} URL :: {} ", httpMethod, url);
        try {
            WebClient.RequestBodySpec requestSpec = buildWebClient(url)
                    .method(httpMethod)
                    .headers(httpHeaders -> {
                        if (requestHeaders != null) {
                            requestHeaders.forEach(httpHeaders::set);
                        }
                    });
            WebClient.RequestHeadersSpec<?> request =
                    requestPayload == null ? requestSpec : requestSpec.bodyValue(requestPayload);

            return request.retrieve()
                    .onStatus(status -> {
                        logger.info("PhonePe Response-code received :: {} ", status);
                        return !status.is2xxSuccessful();
                    }, this::handleError)
                    .bodyToMono(responseDto)
                    .doOnNext(body -> logger.info("PhonePe response received and processing"))
                    .doOnError(PaymentException.class, error ->
                            logger.error("Error while getting PhonePe Response :: {} ", error.getErrorMessage()))
                    .block();
        } catch (PaymentException e) {
            throw e;
        } catch (Exception e) {
            logger.error("PhonePe call failed :: {} ", e.getMessage());
            throw new PaymentException(ErrorConstants.EXTERNAL_SERVICE_ERROR_CODE, "PhonePe service call failed");
        }
    }

    private WebClient buildWebClient(String url) throws SSLException {
        SslContext sslContextForTls12 = SslContextBuilder.forClient()
                .protocols(PaymentConstants.protocols)
                .build();

        HttpClient httpClient =
                HttpClient.create()
                        .proxy(proxy -> proxy.type(ProxyProvider.Proxy.HTTP)
                                .host(https_proxyHost)
                                .port(Integer.parseInt(https_proxyPort)))
                        .secure(ssl -> ssl.sslContext(sslContextForTls12));

        return WebClient.builder().baseUrl(url)
                .clientConnector(new ReactorClientHttpConnector(httpClient))
                .defaultHeader(HttpHeaders.CONTENT_TYPE, MediaType.APPLICATION_JSON_VALUE)
                .build();
    }

    private Mono<? extends Throwable> handleError(ClientResponse clientResponse) {
        return clientResponse.bodyToMono(String.class)
                .defaultIfEmpty("")
                .flatMap(errorBody -> {
                    int statusCode = clientResponse.statusCode().value();
                    logger.error("PhonePe Error Map:: statusCode :: {} ", statusCode);
                    logger.error("PhonePe Error Map:: errorBody :: {} ", errorBody);
                    return Mono.<Throwable>error(new PaymentException(
                            ErrorConstants.EXTERNAL_SERVICE_ERROR_CODE,
                            "PhonePe service returned status " + statusCode));
                });
    }
}




