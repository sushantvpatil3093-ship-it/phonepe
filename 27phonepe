  public PaymentResponse<?>  getCardAuthenticationStatus(PaymentRequestCard paymentRequestCard) {
        PaymentInitiationRequest paymentInitiationRequest=getInitiationCardsRequest(paymentRequestCard);
        validateCardRequest.validateCardRequest(paymentInitiationRequest);
        PayProcIdVisaMasterCard.getPayProdId(paymentInitiationRequest.getPayProcId());
        TransactionDto transactionDto = transactionDao.getValidPaymentAckReq(paymentRequestCard.getAtrn(), PaymentStatus.BOOKED.toString());
        logger.info("transactionDto {} for reference no {} ",transactionDto, transactionDto.getAtrnNum());
        CardOnBoardDetailsResponseDto cardOnboardDto=getConfigDetails(transactionDto.getMerchantId(),paymentRequestCard.getOperatingMode());
        logger.info("Merchant Onboard Details Fetched cardOnBoardDetailsResponseDto {} for reference no {} ",cardOnboardDto,transactionDto.getAtrnNum());

        PVrqResponse pVrqResponse = processPvrqVersioning(transactionDto, paymentRequestCard);
        switch (pVrqResponse.getErrorCode()) {
            case PaymentConstants.SUCCESS_CODE -> {
                PArqResponse pArqResponse = processParqAuthentication(transactionDto, cardOnboardDto, paymentRequestCard, pVrqResponse);
                switch (pArqResponse.getTransStatus()) {
                    case PaymentConstants.CHALLANGE_C -> {
                        PaymentFinalResponse paymentFinalResponse = getRedirectObject(transactionDto, String.valueOf(TransactionStatus.BOOKED), String.valueOf(TransactionStatus.BOOKED));

                        CardVisaResponseDto cardVisaResponseDto = getCardInitiationResponse(paymentFinalResponse,transactionDto,PaymentConstants.PENDING_CONST,transactionDto.getAtrnNum(),pArqResponse.getAcsChallengeReqUrl(),pArqResponse.getCReq());
                        logger.info("pArq Response received cardVisaResponseDto {} for reference no {} ", cardVisaResponseDto, transactionDto.getAtrnNum());
                        return PaymentResponse.<CardVisaResponseDto>builder().data(List.of(cardVisaResponseDto)).status(PaymentConstants.API_RESPONSE_STATUS_SUCCESS).build();
                    }
                    case PaymentConstants.CHALLANGE_A, PaymentConstants.YES -> {
                        SaleAPIResponse saleAPIResponse = processSaleRequest(cardOnboardDto, transactionDto, paymentRequestCard, pArqResponse);
                        if (saleAPIResponse.getStatus().equalsIgnoreCase(PaymentConstants.PG_SUCCESS) && saleAPIResponse.getPgErrorCode().equalsIgnoreCase(PaymentConstants.ZERO)) {
                            PaymentFinalResponse paymentFinalResponse = getRedirectObject(transactionDto,PaymentConstants.SUCCESS_DESC, PaymentConstants.SUCCESS_DESC);

                            return PaymentResponse.<CardVisaFrictionlessResponseDto>builder().data(List.of(CardVisaFrictionlessResponseDto.builder().cardPaymentStatus(paymentFinalResponse.getTransactionStatus().equals(PaymentConstants.SUCCESS_DESC) ? PaymentConstants.SUCCESS_DESC : PaymentConstants.FAILED).atrn(transactionDto.getAtrnNum()).availableAuthMode(PaymentConstants.VISA_Frictionless)
                                    .encryptedPaymentFinalResponse(paymentCallbackForwardService.processInitiationResponse(paymentFinalResponse,transactionDto,orderDao.getOrderDetails(transactionDto))).orderRetryCount(paymentFinalResponse.getOrderRetryCount()).atrnNumber(paymentFinalResponse.getAtrn()).transactionStatus(paymentFinalResponse.getTransactionStatus()).reason(paymentFinalResponse.getReason()).sbiOrderRefNumber(paymentFinalResponse.getSbiOrderId()).orderRefNumber(paymentFinalResponse.getMerchantOrderNumber()).totalAmount(paymentFinalResponse.getTotalAmount())
                                    .returnUrl(orderDao.getOrderDetails(transactionDto).getReturnUrl()).currencyCode(transactionDto.getCurrencyCode()).mId(transactionDto.getMerchantId()).build())).status(PaymentConstants.API_RESPONSE_STATUS_SUCCESS).build();

                        } else {
                            PaymentFinalResponse paymentFinalResponse = getRedirectObject(transactionDto, String.valueOf(TransactionStatus.FAILED), String.valueOf(TransactionStatus.FAILED));
                            CardVisaResponseDto cardVisaResponseDto = getCardInitiationResponse(paymentFinalResponse,transactionDto,PaymentConstants.FAILURE_CONST,transactionDto.getAtrnNum(),PaymentConstants.initiateURL,PaymentConstants.dummyHash);
                            logger.info("Sale Response received failed for cardVisaResponseDto {} for reference no {} ", cardVisaResponseDto, transactionDto.getAtrnNum());
                            return PaymentResponse.<CardVisaResponseDto>builder().data(List.of(cardVisaResponseDto)).status(PaymentConstants.API_RESPONSE_STATUS_FAIL).errors(List.of(getResponseDto(saleAPIResponse.getPgErrorCode(),saleAPIResponse.getPgErrorDetail(),transactionDto.getAtrnNum(),saleAPIResponse.getTransactionId()))).build();
                        }
                    }
                    default -> {
                        PaymentFinalResponse paymentFinalResponse = getRedirectObject(transactionDto, String.valueOf(TransactionStatus.FAILED), String.valueOf(TransactionStatus.FAILED));
                        CardVisaResponseDto cardVisaResponseDto = getCardInitiationResponse(paymentFinalResponse,transactionDto,PaymentConstants.FAILURE_CONST,transactionDto.getAtrnNum(),PaymentConstants.initiateURL,PaymentConstants.dummyHash);
                        logger.info("pArq Response received failed for cardVisaResponseDto {} for reference no {} ", cardVisaResponseDto, transactionDto.getAtrnNum());
                        return PaymentResponse.<CardVisaResponseDto>builder().data(List.of(cardVisaResponseDto)).status(PaymentConstants.API_RESPONSE_STATUS_FAIL).errors(List.of(getResponseDto(pArqResponse.getErrorCode(),pArqResponse.getErrorDescription(),transactionDto.getAtrnNum(),pArqResponse.getThreeDSServerTransID()))).build();
                    }
                }
            }
            default -> {
                PaymentFinalResponse paymentFinalResponse = getRedirectObject(transactionDto, String.valueOf(TransactionStatus.FAILED), String.valueOf(TransactionStatus.FAILED));
                CardVisaResponseDto cardVisaResponseDto = getCardInitiationResponse(paymentFinalResponse,transactionDto,PaymentConstants.FAILURE_CONST,transactionDto.getAtrnNum(),PaymentConstants.initiateURL,PaymentConstants.dummyHash);
                logger.info("pVrq Response received failed for cardVisaResponseDto {} for reference no {} ", cardVisaResponseDto, transactionDto.getAtrnNum());
                return PaymentResponse.<CardVisaResponseDto>builder().data(List.of(cardVisaResponseDto)).status(PaymentConstants.API_RESPONSE_STATUS_FAIL).errors(List.of(getResponseDto(pVrqResponse.getErrorCode(),PaymentConstants.FAILED,transactionDto.getAtrnNum(),pVrqResponse.getThreeDSServerTransID()))).build();
            }
        }
    }

    /**
     * @return: SaleAPIResponse
     * @methodName: processSaleRequest
     * @@Method-Description: Process sale request
     * @param: cardOnboardDto,  transactionDto,  paymentRequestCard,  altIDResponse,  pArqResponse
