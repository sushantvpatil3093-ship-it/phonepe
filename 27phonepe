    public String getPayProc(String payprocType){
        String payProc = null;
        if ("CREDIT LINE".equals(payprocType) || "CREDITLINE01".equals(payprocType) || "CREDITLINE02".equals(payprocType) || "CREDITLINE03".equals(payprocType) ||
                "CREDITLINE04".equals(payprocType) || "CREDITLINE05".equals(payprocType) || "CREDITLINE06".equals(payprocType) ||
                "CREDITLINE07".equals(payprocType) || "CREDITLINE08".equals(payprocType) || "CREDITLINE09".equals(payprocType) || "CREDITLINE10".equals(payprocType)) {
            payProc = PaymentConstants.PAYPROC_BHIMQR_CLNIB;
        } else if ("CL01".equals(payprocType) || "CL02".equals(payprocType) || "CL03".equals(payprocType) || "CL04".equals(payprocType) ||
                "CL05".equals(payprocType) || "CL06".equals(payprocType) || "CL07".equals(payprocType) ||
                "CL08".equals(payprocType) || "CL09".equals(payprocType) || "CL10".equals(payprocType) || "CL011".equals(payprocType) || "CL012".equals(payprocType) ||
                "CL013".equals(payprocType) || "CL014".equals(payprocType) || "CL015".equals(payprocType) || "SOD".equals(payprocType)) {
            payProc = PaymentConstants.PAYPROC_BHIMQR_CLIB;
        } else if ("CREDIT".equals(payprocType)) {
            payProc = PaymentConstants.PAYPROC_BHIMQR_CC;
        } else if ("PPIWALLET".equals(payprocType) || "BANKWALLET".equals(payprocType) || "Voucher".equals(payprocType)) {
            payProc = PaymentConstants.PAYPROC_BHIMQR_PPI;
        }
     else {
        payProc = PaymentConstants.PAYPROC_BHIMQR;
         }
        return payProc;
    }

