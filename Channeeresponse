package com.epay.payment.dto;

import com.fasterxml.jackson.annotation.JsonInclude;
import com.fasterxml.jackson.annotation.JsonProperty;

@JsonInclude(JsonInclude.Include.ALWAYS)
public class ChannelDetails {

    @JsonProperty("Flag")
    private String flag;

    @JsonProperty("mLimit")
    private String mLimit;

    @JsonProperty("cId")
    private String cId;

    @JsonProperty("eLimit")
    private String eLimit;

    @JsonProperty("ExpDate")
    private String expDate;

    public ChannelDetails() {
    }

    public ChannelDetails(String flag, String mLimit,
                          String cId, String eLimit) {
        this.flag = flag;
        this.mLimit = mLimit;
        this.cId = cId;
        this.eLimit = eLimit;
    }

    public ChannelDetails(String flag, String cId, String expDate) {
        this.flag = flag;
        this.cId = cId;
        this.expDate = expDate;
    }

    public String getFlag() {
        return flag;
    }

    public String getMLimit() {
        return mLimit;
    }

    public String getCId() {
        return cId;
    }

    public String getELimit() {
        return eLimit;
    }

    public String getExpDate() {
        return expDate;
    }
}
